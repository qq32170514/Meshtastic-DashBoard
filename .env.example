# ========================================================
# Meshtastic DashBoard 環境變數設定範本 (.env.example)
# 請將此檔案複製為 .env 並填入實際連線資訊
# ========================================================

# 服務監聽連接埠
PORT=3002

# HiveMQ Cloud MQTT 連線設定 (私有節點轉發)
HIVEMQ_URL=mqtts://your-cluster-id.s1.eu.hivemq.cloud
HIVEMQ_USER=your_username
HIVEMQ_PASSWORD=your_password_here

# 後端管理者存取密碼
ADMIN_PASSWORD=your_admin_password_here

# 中央氣象署 (CWA) 開放資料平台 API Key
CWA_API_KEY=your_cwa_api_key_here

# 資料庫自動備份目標目錄 (選填，例如 Google 雲端硬碟同步目錄)
# BACKUP_PATH=D:\雲端硬碟同步用\Meshtastic_Backup
