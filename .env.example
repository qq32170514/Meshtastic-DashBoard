# ========================================================
# Meshtastic DashBoard Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to Git!
# ========================================================

# Server Port (Default: 3000)
PORT=3000

# MQTT Broker Configuration
MQTT_BROKER=
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPICS=

# Central Weather Administration (CWA) API Key (Optional)
CWA_API_KEY=

# Meshtastic Custom Channel PSKs (JSON Array of { name, key })
# Note: MediumFast is built-in as a public default key.
MESHTASTIC_CHANNEL_KEYS_JSON=

# Database Automatic Backup Target Directory (Optional)
BACKUP_PATH=

# Allowed CORS Origins (Comma-separated, Optional, Default: Same-Origin)
ALLOWED_ORIGINS=
